rules_version = '2';

/*
|--------------------------------------------------------------------------
| Firestore Access Rules
|--------------------------------------------------------------------------
|
| Public marketplace data is readable so customers can discover stores and
| products. Account-specific data is restricted to its authenticated owner.
| Store owners can manage only the store, products, and orders assigned to
| their own store.
|
| Cloud Functions use the Admin SDK and are not constrained by these rules.
|
*/

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userAccountType(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data.accountType;
    }

    function isAdmin() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.isActive == true &&
        get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.email == request.auth.token.email;
    }

    function isStoreOwnerAccount() {
      return signedIn() &&
        userAccountType(request.auth.uid) == "store_owner";
    }

    function isCustomerAccount() {
      return signedIn() &&
        userAccountType(request.auth.uid) == "customer";
    }

    function isDriverAccount() {
      return signedIn() &&
        userAccountType(request.auth.uid) == "driver";
    }

    /*
     * Document image processing and administrator document review are two
     * separate concerns. Drivers may initialize review fields as pending,
     * but cannot approve, reject, expire, or alter a reviewer decision.
     */
    function documentReviewIsClientSafe(
      previousDocument,
      nextDocument,
      materialDocumentFields
    ) {
      return !previousDocument.keys().hasAny([
        "reviewStatus",
        "rejectionReason",
        "reviewedAt",
        "reviewedBy",
      ])
        ? (
          !nextDocument.keys().hasAny([
            "reviewStatus",
            "rejectionReason",
            "reviewedAt",
            "reviewedBy",
          ]) || (
            nextDocument.keys().hasAll([
              "reviewStatus",
              "rejectionReason",
              "reviewedAt",
              "reviewedBy",
            ]) &&
            nextDocument.reviewStatus == "pending" &&
            nextDocument.rejectionReason == null &&
            nextDocument.reviewedAt == null &&
            nextDocument.reviewedBy == null
          )
        )
        : (
          (
            nextDocument.keys().hasAll([
              "reviewStatus",
              "rejectionReason",
              "reviewedAt",
              "reviewedBy",
            ]) &&
            nextDocument.reviewStatus == previousDocument.reviewStatus &&
            nextDocument.rejectionReason == previousDocument.rejectionReason &&
            nextDocument.reviewedAt == previousDocument.reviewedAt &&
            nextDocument.reviewedBy == previousDocument.reviewedBy
          ) || (
            /* A material driver edit may resubmit only that document. */
            nextDocument.keys().hasAll([
              "reviewStatus",
              "rejectionReason",
              "reviewedAt",
              "reviewedBy",
            ]) &&
            nextDocument.reviewStatus == "pending" &&
            nextDocument.rejectionReason == null &&
            nextDocument.reviewedAt == null &&
            nextDocument.reviewedBy == null &&
            nextDocument.diff(previousDocument).affectedKeys()
              .hasAny(materialDocumentFields)
          )
        );
    }

    function driverDocumentReviewsAreClientSafe() {
      return documentReviewIsClientSafe(
        resource.data.keys().hasAny(["driversLicense"])
          ? resource.data.driversLicense
          : {},
        request.resource.data.keys().hasAny(["driversLicense"])
          ? request.resource.data.driversLicense
          : {},
        [
          "frontDocumentUrl",
          "backDocumentUrl",
          "submissionVersion",
          "issuingState",
          "expirationDate",
        ]
      ) && documentReviewIsClientSafe(
        resource.data.keys().hasAny(["vehicleInsurance"])
          ? resource.data.vehicleInsurance
          : {},
        request.resource.data.keys().hasAny(["vehicleInsurance"])
          ? request.resource.data.vehicleInsurance
          : {},
        [
          "documentUrl",
          "submissionVersion",
          "provider",
          "expirationDate",
        ]
      ) && documentReviewIsClientSafe(
        resource.data.keys().hasAny(["vehicleRegistration"])
          ? resource.data.vehicleRegistration
          : {},
        request.resource.data.keys().hasAny(["vehicleRegistration"])
          ? request.resource.data.vehicleRegistration
          : {},
        [
          "documentUrl",
          "submissionVersion",
          "expirationDate",
        ]
      );
    }

    /*
    |-----------------------------------------------------------------------
    | Driver Application Lifecycle
    |-----------------------------------------------------------------------
    |
    | A driver may submit their own draft for review once. Only an
    | administrator can approve, reject, suspend, or activate a driver.
    |
    */
    function driverLifecycleIsClientSafe() {
      let currentStatus = resource.data.keys().hasAny(["status"])
        ? resource.data.status
        : "draft";
      let nextStatus = request.resource.data.keys().hasAny(["status"])
        ? request.resource.data.status
        : "draft";
      let nextAvailabilityStatus = request.resource.data.keys().hasAny([
        "availabilityStatus",
      ])
        ? request.resource.data.availabilityStatus
        : "offline";

      return (
        nextStatus == currentStatus ||
        (currentStatus == "draft" && nextStatus == "pending_review")
      ) && nextAvailabilityStatus == "offline";
    }

    /* Store owners may submit a draft, while administrators own review state. */
    function storeLifecycleIsClientSafe() {
      let currentStatus = resource.data.keys().hasAny(["status"])
        ? resource.data.status
        : "draft";
      let nextStatus = request.resource.data.keys().hasAny(["status"])
        ? request.resource.data.status
        : "draft";

      return nextStatus == currentStatus ||
        (currentStatus == "draft" && nextStatus == "pending_review");
    }

    /* Only an administrator may assign or change a usable delivery radius. */
    function driverApprovedRadiusIsClientSafe() {
      return (
        !resource.data.keys().hasAny(["serviceArea"]) ||
        !resource.data.serviceArea.keys().hasAny(["approvedRadiusMiles"])
      )
        ? (
          !request.resource.data.keys().hasAny(["serviceArea"]) ||
          !request.resource.data.serviceArea.keys().hasAny([
            "approvedRadiusMiles",
          ]) ||
          request.resource.data.serviceArea.approvedRadiusMiles == null
        )
        : (
          request.resource.data.keys().hasAny(["serviceArea"]) &&
          request.resource.data.serviceArea.keys().hasAny([
            "approvedRadiusMiles",
          ]) &&
          request.resource.data.serviceArea.approvedRadiusMiles ==
            resource.data.serviceArea.approvedRadiusMiles
        );
    }

    /*
     * Store-upload review status is managed by the authenticated upload API
     * and administrators. These checks prevent store owners from approving
     * or altering review outcomes from the browser.
     */
    function storeUploadReviewsAreClientSafe() {
      return documentReviewIsClientSafe(
        resource.data.keys().hasAny(["owner"]) &&
          resource.data.owner.keys().hasAny(["photoIdReview"])
          ? resource.data.owner.photoIdReview
          : {},
        request.resource.data.keys().hasAny(["owner"]) &&
          request.resource.data.owner.keys().hasAny(["photoIdReview"])
          ? request.resource.data.owner.photoIdReview
          : {},
        ["photoIdUrl", "photoIdSubmissionVersion"]
      ) && documentReviewIsClientSafe(
        resource.data.keys().hasAny(["logoReview"])
          ? resource.data.logoReview
          : {},
        request.resource.data.keys().hasAny(["logoReview"])
          ? request.resource.data.logoReview
          : {},
        ["logoUrl", "logoSubmissionVersion"]
      ) && documentReviewIsClientSafe(
        resource.data.keys().hasAny(["bannerReview"])
          ? resource.data.bannerReview
          : {},
        request.resource.data.keys().hasAny(["bannerReview"])
          ? request.resource.data.bannerReview
          : {},
        ["bannerUrl", "bannerSubmissionVersion"]
      ) && documentReviewIsClientSafe(
        resource.data.keys().hasAny(["storeFrontReview"])
          ? resource.data.storeFrontReview
          : {},
        request.resource.data.keys().hasAny(["storeFrontReview"])
          ? request.resource.data.storeFrontReview
          : {},
        ["storeFrontUrl", "storeFrontSubmissionVersion"]
      ) && documentReviewIsClientSafe(
        resource.data.keys().hasAny(["storeInsideReview"])
          ? resource.data.storeInsideReview
          : {},
        request.resource.data.keys().hasAny(["storeInsideReview"])
          ? request.resource.data.storeInsideReview
          : {},
        ["storeInsideUrl", "storeInsideSubmissionVersion"]
      );
    }

    function newStoreOwnerPhotoIdReviewIsPending() {
      return request.resource.data.keys().hasAny(["owner"]) &&
        request.resource.data.owner.keys().hasAny(["photoIdReview"]) &&
        documentReviewIsClientSafe(
          {},
          request.resource.data.owner.photoIdReview,
          ["photoIdUrl", "photoIdSubmissionVersion"]
        );
    }

    function ownsStore(storeId) {
      return isStoreOwnerAccount() &&
        get(
          /databases/$(database)/documents/stores/$(storeId)
        ).data.ownerId == request.auth.uid;
    }

    /*
     * A store owner cannot manage catalogue data until an administrator has
     * approved the completed application. This is deliberately checked from
     * the protected store document instead of trusting a browser flag.
     */
    function ownsApprovedStore(storeId) {
      return ownsStore(storeId) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)
        ).data.isApproved == true &&
        get(
          /databases/$(database)/documents/stores/$(storeId)
        ).data.onboardingCompleted == true;
    }

    function ownsOrder(orderData) {
      return ownsStore(orderData.store.id);
    }

    /*
     * New orders store the customer at customer.uid. Some older order
     * documents use customerId, so keep that ownership check while the
     * legacy orders remain in the database.
     */
    function isOrderCustomer(orderData) {
      return (
        orderData.keys().hasAll(["customer"]) &&
        orderData.customer.keys().hasAll(["uid"]) &&
        orderData.customer.uid == request.auth.uid
      ) || (
        orderData.keys().hasAll(["customerId"]) &&
        orderData.customerId == request.auth.uid
      );
    }

    /*
     * A customer may read the full order only after the Stripe webhook has
     * atomically confirmed checkout and payment. Before that point, checkout
     * listens to its restricted checkoutSessions document instead.
     */
    function isPaidConfirmedCustomerOrder(orderData) {
      return isCustomerAccount() &&
        isOrderCustomer(orderData) &&
        orderData.keys().hasAll([
          "checkoutStatus",
          "payment",
        ]) &&
        orderData.checkoutStatus == "confirmed" &&
        orderData.payment.keys().hasAll(["status"]) &&
        orderData.payment.status == "paid";
    }

    /*
     * Store owners may follow their own fulfilment orders in real time only
     * after the payment webhook has confirmed the order. This mirrors the
     * customer visibility rule and prevents a store from seeing an unpaid
     * checkout attempt that happens to reference its store ID.
     */
    function isPaidConfirmedStoreOrder(orderData) {
      return isStoreOwnerAccount() &&
        ownsOrder(orderData) &&
        orderData.keys().hasAll([
          "checkoutStatus",
          "payment",
        ]) &&
        orderData.checkoutStatus == "confirmed" &&
        orderData.payment.keys().hasAll(["status"]) &&
        orderData.payment.status == "paid";
    }

    /*
    |----------------------------------------------------------------------
    | User Account Data
    |----------------------------------------------------------------------
    */

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();

      /*
       * Initial profiles are created only by the authenticated callable.
       * This prevents a browser from assigning account lifecycle fields.
       */
      allow create: if false;

      /*
       * Account type and UID are immutable from the client. This prevents a
       * customer from changing their own profile into another account type.
       */
      allow update: if isSelf(userId) &&
        request.resource.data.uid == request.auth.uid &&
        (
          !resource.data.keys().hasAll(["uid"]) ||
          request.resource.data.uid == resource.data.uid
        ) &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "defaultAddress",
          "displayName",
          "driverId",
          "email",
          "language",
          "onboardingCompleted",
          "phone",
          "profileImagePath",
          "profileImageStatus",
          "profileImageUrl",
          "recentSearches",
          "storeId",
          "updatedAt",
        ]);

      allow delete: if isSelf(userId) || isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(userId) || isAdmin();
        allow create: if isAdmin();
      }
    }

    /*
     * Administrator records are provisioned manually with the Firebase Auth
     * UID as their document ID. They are never browser-readable or writable;
     * protected Admin Functions verify them with the Admin SDK.
     */
    match /admins/{adminId} {
      allow read, write: if false;
    }

    /* Immutable server-managed records for administrator mutations. */
    match /adminAuditLogs/{auditLogId} {
      allow read, write: if false;
    }

    /*
    |----------------------------------------------------------------------
    | Customer-Owned Documents
    |----------------------------------------------------------------------
    */

    match /addresses/{userId} {
      allow read, delete: if isSelf(userId) || isAdmin();
      allow create, update: if isSelf(userId) &&
        request.resource.data.userId == request.auth.uid;
    }

    match /carts/{userId} {
      /* Cart persistence is handled by the authenticated customer API. */
      allow read, delete: if isCustomerAccount() && isSelf(userId);
      allow create, update: if isCustomerAccount() &&
        isSelf(userId) &&
        request.resource.data.userId == request.auth.uid;
    }

    /*
     * Checkout sessions are short-lived, customer-owned payment state. They
     * deliberately contain no card data or Stripe client secret. The browser
     * may read only one of its own sessions; all writes remain server-only.
     */
    match /checkoutSessions/{sessionId} {
      allow get: if isCustomerAccount() &&
        resource.data.customerUid == request.auth.uid;

      allow list, create, update, delete: if false;
    }

    match /notificationDevices/{deviceId} {
      /*
       * Device tokens are sensitive credentials. Registration, de-duplication,
       * and stale-token cleanup run only through Cloud Functions.
       */
      allow read, write: if false;
    }

    /*
    |----------------------------------------------------------------------
    | Driver Applications
    |----------------------------------------------------------------------
    |
    | Driver identity, address, vehicle, and document data are private. A
    | driver may update their own application but cannot approve themselves
    | or replace the server-managed Stripe connection.
    |
    */
    match /drivers/{driverId} {
      /* Driver onboarding and workspace are callable-only. */
      allow get, list, create, update, delete: if isAdmin();
    }

    /*
     * Sanitized server-managed status cards. These provide real-time driver
     * approval, Stripe readiness, and document review state without granting
     * browser access to drivers/{driverId} or any document URL.
     */
    match /driverWorkspaceStatuses/{driverId} {
      allow get: if isSelf(driverId);
      allow list, create, update, delete: if false;
    }

    /* Store owners can watch their own lifecycle status, not stores/{id}. */
    match /storeWorkspaceStatuses/{ownerId} {
      allow get: if isSelf(ownerId);
      allow list, create, update, delete: if false;
    }

    /*
    |----------------------------------------------------------------------
    | Marketplace Catalog
    |----------------------------------------------------------------------
    */

    match /stores/{storeId} {
      /*
       * The application document contains private owner identity, business,
       * document-review, and Stripe data. Customers read the deliberately
       * sanitized storePublicProfiles collection below instead.
       */
      /* Store applications are callable-only for owners and administrators. */
      allow get, list: if isAdmin();

      /* Store drafts are created only by protected onboarding callables. */
      allow create: if false;

      /*
       * Store owners manage their profile, but only an administrator may
       * approve a store or publish it to customers. Existing onboarding
       * drafts may initialize absent lifecycle flags to false once.
       */
      /*
       * Store settings, geocoding, schedules, Stripe state, and lifecycle
       * changes are all callable-managed. Never leave an alternate browser
       * write path that could bypass server validation.
       */
      allow update: if isAdmin();

      /* Account deletion is an administrator-reviewed backend workflow. */
      allow delete: if isAdmin();
    }

    /*
     * This is the only store document readable by customers. A Function
     * mirrors a small allowlist from stores/{storeId}, never owner documents,
     * EIN, document review data, or Stripe connection details.
     */
    match /storePublicProfiles/{storeId} {
      /*
       * This collection is a server-managed, deliberately sanitized public
       * projection. The sync Function creates it only for approved, active
       * stores and deletes it otherwise. Public reads keep real-time customer
       * discovery reliable without exposing the private stores collection.
       */
      allow get, list: if true;
      allow write: if false;
    }

    /*
     * Private source-of-truth inventory. Store pages use authenticated
     * callables; customer pages use productPublicProfiles below.
     */
    match /products/{productId} {
      allow get, list: if isAdmin();

      /* Product changes are validated and written only by Cloud Functions. */
      allow create, update, delete: if isAdmin();

            /*
            * Product gallery image documents.
            *
            * Path:
            * products/{productId}/images/{imageId}
            */
      match /images/{imageId} {
        allow get, list: if isAdmin();

              /*
              * Only the store that owns the parent product, or an admin,
              * may manage its gallery images.
              */
        allow create, update, delete: if isAdmin();
      }
    }

    /*
     * Customer-safe catalog projection. Functions mirror only approved,
     * active-store products and ready image variants into this collection.
     */
    match /productPublicProfiles/{productId} {
      allow read: if true;
      allow write: if false;

      match /images/{imageId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /*
    |----------------------------------------------------------------------
    | Orders
    |----------------------------------------------------------------------
    */

    match /orders/{orderId} {
      allow read: if signedIn() && (
        isPaidConfirmedCustomerOrder(resource.data) ||
        isPaidConfirmedStoreOrder(resource.data) ||
        isAdmin()
      );

      /*
       * Customer checkout creates orders through the createOrder Callable
       * Function, which rechecks inventory and price server-side.
       */
      allow create, delete: if isAdmin();

      /*
       * All fulfilment transitions go through updateOrderStatus. The Callable
       * verifies ownership, paid state, valid transition sequence, reasons,
       * Shipday effects, and timeline integrity before using the Admin SDK.
       */
      allow update: if isAdmin();
    }

    /*
     * No browser access is granted to undeclared collections. This is also
     * important for admins/{uid} and adminAuditLogs/{id}: Firestore matches
     * overlapping rules as an OR, so an admin-wide fallback would otherwise
     * accidentally expose those private server-managed collections.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
