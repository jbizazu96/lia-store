{
  "name": "lia-store",
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "XDG_CONFIG_HOME=.firebase-test/config FIREBASE_CLI_DISABLE_UPDATE_CHECK=1 firebase emulators:exec --config firebase.test.json --project demo-lia-store-tests --only firestore,storage \"vitest run --config vitest.integration.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:rules && npm run test:e2e",
    "verify": "npm run lint && tsc --noEmit && npm --prefix functions run lint && npm --prefix functions run build && npm run test && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@react-google-maps/api": "^2.20.8",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.8.0",
    "capacitor-native-settings": "^8.2.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.40.0",
    "glob": "^13.0.6",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-pwa": "^5.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "react-hot-toast": "^2.6.0",
    "stripe": "^22.2.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "firebase-tools": "^15.26.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
