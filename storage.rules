rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsStore(storeId) {
      return signedIn() &&
        request.auth.token.storeUploadStoreId == storeId &&
        firestore.exists(
          /databases/(default)/documents/stores/$(storeId)
        ) &&
        firestore.get(
          /databases/(default)/documents/stores/$(storeId)
        ).data.ownerId == request.auth.uid;
    }

    function ownsApprovedStore(storeId) {
      return ownsStore(storeId) &&
        firestore.get(
          /databases/(default)/documents/stores/$(storeId)
        ).data.onboardingCompleted == true &&
        firestore.get(
          /databases/(default)/documents/stores/$(storeId)
        ).data.isApproved == true;
    }

    function canManageStoreApplication(storeId) {
      return ownsStore(storeId) && (
        firestore.get(
          /databases/(default)/documents/stores/$(storeId)
        ).data.onboardingCompleted != true ||
        firestore.get(
          /databases/(default)/documents/stores/$(storeId)
        ).data.isApproved == true
      );
    }

    /*
     * Product-image authorization uses the server-issued store claim instead
     * of Firestore lookups. This avoids depending on Storage-to-Firestore Rules
     * integration for every upload. The gallery reservation callable and image
     * processor independently verify the product, store, and image identity.
     */
    function isSupportedProductImage() {
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "image/(jpeg|png|webp|avif|heic|heif)"
        );
    }

    function ownsProductUploadStore(storeId) {
      return signedIn() &&
        request.auth.token.storeUploadStoreId == storeId;
    }

    function ownsDriver(driverId) {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/drivers/$(driverId)
        ).data.ownerUid == request.auth.uid;
    }

    function isSupportedDriverImage() {
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "image/(jpeg|png|webp|avif|heic|heif)"
        );
    }

    function isSupportedStoreImage() {
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "image/(jpeg|png|webp|avif|heic|heif)"
        );
    }

    function isSupportedCustomerProfileImage() {
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "image/(jpeg|png|webp|avif|heic|heif)"
        );
    }

    function isActiveAdmin() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }

    function isStoreImageField(imageField) {
      return imageField == "logo" ||
        imageField == "banner" ||
        imageField == "owner-photo-id" ||
        imageField == "front" ||
        imageField == "inside";
    }

    function isSupportedClaimEvidence() {
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "image/(jpeg|png|webp|heic|heif)"
        );
    }

    /*
    |--------------------------------------------------------------------------
    | Public Optimized Images
    |--------------------------------------------------------------------------
    |
    | Customer-facing images are public.
    |
    */
    match /stores/{storeId}/products/{productId}/gallery/{imageId}/optimized/{fileName} {
      allow read: if true;

      // Only Firebase Functions (Admin SDK) should write optimized files.
      allow write: if false;
    }

    /*
    |--------------------------------------------------------------------------
    | Original Product Images
    |--------------------------------------------------------------------------
    |
    | Store owners upload originals here.
    | Firebase Functions later process them.
    |
    */
    match /stores/{storeId}/products/{productId}/gallery/{imageId}/{fileName} {
      allow read: if ownsProductUploadStore(storeId);

      /*
       * The owner can upload only a supported original under their own store
       * claim. Product ownership and the exact canonical path are verified by
       * the callable reservation and background processor.
       */
      allow create: if ownsProductUploadStore(storeId) &&
        isSupportedProductImage() &&
        request.resource.metadata.storeId == storeId &&
        request.resource.metadata.productId == productId &&
        request.resource.metadata.imageId == imageId &&
        request.resource.metadata.galleryImageId == imageId &&
        request.resource.metadata.processingType == "product-gallery-image-original" &&
        fileName.matches("original\\.(jpg|jpeg|png|webp|avif|heic|heif)");
      allow update, delete: if false;
    }

    /*
     * Store onboarding and Settings uploads.
     * Browser uploads only originals; the processStoreImage Function writes
     * optimized files with the Admin SDK.
     */
    match /stores/{storeId}/images/originals/{imageField}/{fileName} {
      allow read: if canManageStoreApplication(storeId);
      allow write: if canManageStoreApplication(storeId) &&
        isStoreImageField(imageField) &&
        isSupportedStoreImage() &&
        request.resource.metadata.storeId == storeId &&
        request.resource.metadata.imageField == imageField &&
        request.resource.metadata.processingType == "store-image-original" &&
        request.resource.metadata.imageId.matches(
          "[0-9]+-[0-9a-fA-F-]{36}"
        ) &&
        fileName.matches(
          request.resource.metadata.imageId +
          "\\.(jpg|jpeg|png|webp|avif|heic|heif)"
        );
    }

    match /stores/{storeId}/images/optimized/{imageField}/{fileName} {
      allow read: if imageField == "logo" ||
        imageField == "banner" ||
        imageField == "front" ||
        imageField == "inside";
      allow write: if false;
    }

    /* Owner verification images are never readable through Storage rules. */
    match /stores/{storeId}/images/optimized/owner-photo-id/{fileName} {
      allow read: if canManageStoreApplication(storeId);
      allow write: if false;
    }

    /* Signed contracts are exact private originals; Functions issue previews. */
    match /stores/{storeId}/contracts/{fileName} {
      allow read: if false;
      allow create: if isActiveAdmin() &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType == "application/pdf" &&
        request.resource.metadata.storeId == storeId &&
        request.resource.metadata.processingType == "store-contract-original" &&
        fileName == request.resource.metadata.contractId + ".pdf" &&
        firestore.exists(/databases/(default)/documents/stores/$(storeId)/contracts/$(request.resource.metadata.contractId)) &&
        firestore.get(/databases/(default)/documents/stores/$(storeId)/contracts/$(request.resource.metadata.contractId)).data.status == "reserved";
      allow update, delete: if false;
    }

    /*
     * Driver onboarding uploads use the same resize-only pipeline as store
     * profile images. All driver document images remain private.
     */
    match /drivers/{driverId}/images/originals/{imageField}/{fileName} {
      allow read: if ownsDriver(driverId);

      /* Browser validation is not a security boundary. */
      allow write: if ownsDriver(driverId) && isSupportedDriverImage();
    }

    match /drivers/{driverId}/images/optimized/{imageField}/{fileName} {
      allow read: if ownsDriver(driverId);
      allow write: if false;
    }

    /* Customer profile photos are private to their authenticated owner. */
    match /users/{userId}/images/originals/profile/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() &&
        request.auth.uid == userId &&
        isSupportedCustomerProfileImage() &&
        request.resource.metadata.userId == userId &&
        request.resource.metadata.processingType ==
          "customer-profile-image-original" &&
        request.resource.metadata.imageId.matches(
          "[0-9]+-[0-9a-fA-F-]{36}"
        ) &&
        fileName.matches(
          request.resource.metadata.imageId +
          "\\.(jpg|jpeg|png|webp|avif|heic|heif)"
        );
    }

    match /users/{userId}/images/optimized/profile/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    /*
     * Claim evidence is private. A customer may upload only into their own
     * reserved path; the claim callable verifies the object metadata and the
     * admin callable returns a short-lived URL after admin authorization.
     */
    match /users/{userId}/refund-claim-evidence/{orderId}/{evidenceUploadId}/{fileName} {
      allow read: if false;
      allow write: if signedIn() &&
        request.auth.uid == userId &&
        fileName.matches("original\\.(jpg|jpeg|png|webp|heic|heif)") &&
        isSupportedClaimEvidence() &&
        request.resource.metadata.customerId == userId &&
        request.resource.metadata.orderId == orderId &&
        request.resource.metadata.evidenceUploadId == evidenceUploadId;
    }

    /*
    |--------------------------------------------------------------------------
    | Everything Else
    |--------------------------------------------------------------------------
    */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
