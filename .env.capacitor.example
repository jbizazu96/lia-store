# Public production origin loaded by the customer-only Capacitor shell.
NEXT_PUBLIC_APP_URL=https://www.liamarketplace.com
CAPACITOR_SERVER_URL=https://www.liamarketplace.com

# Used by the production .well-known association responses. Configure these
# in Vercel before testing Universal Links and Android App Links.
APPLE_TEAM_ID=YOUR_10_CHARACTER_APPLE_TEAM_ID
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:REPLACE_WITH_RELEASE_CERTIFICATE_SHA256

# Hosted native-shell release policy. Versions use major.minor.patch.
# Leave a platform value empty until that store listing URL exists.
NATIVE_IOS_MINIMUM_VERSION=1.0.0
NATIVE_IOS_LATEST_VERSION=1.0.0
NATIVE_IOS_STORE_URL=
NATIVE_ANDROID_MINIMUM_VERSION=1.0.0
NATIVE_ANDROID_LATEST_VERSION=1.0.0
NATIVE_ANDROID_STORE_URL=
